      "prompt": "roles/qa-tests.md",
      "allowedWriteRoots": [
        "test"
      ]
    }
  },
  "prompts": {
    "planner": "roles/planner.md",
    "checker": "roles/checker.md",
    "qa": "roles/qa.md",
    "testing": "roles/testing.md"
  },
  "verificationProfile": "pi-palantir-v1"
}
