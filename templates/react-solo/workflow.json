{
  "version": 1,
  "name": "react-solo",
  "start": "engineering",
  "maxSteps": 1,
  "timeouts": {
    "stepSeconds": 1200,
    "workflowSeconds": 3600
  },
  "roles": {
    "engineering": {
      "prompt": "roles/engineering.md",
      "write": true,
      "on": {
        "completed": "done"
      }
    }
  },
  "output": {
    "directory": "dist",
    "maxFiles": 500,
    "maxBytes": 10485760,
    "smoke": {
      "path": "/",
      "status": 200,
      "contains": "BIMO_DEMO_READY"
    }
  }
}
