#!/usr/bin/env node

const command = process.argv[2];
if (command === "source-verify") {
  process.argv.splice(2, 1);
  const { main } = await import("../src/source-verify.mjs");
  main().catch(error => {
    process.stderr.write(`bimo source-verify: ${error.message}\n`);
    process.exitCode = 1;
  });
} else {
  const internal = new Map([
    ["agent", "../src/agent.mjs"],
    ["bootstrap", "../src/bootstrap.mjs"],
    ["probe", "../src/probe.mjs"],
    ["proxy", "../src/credential-proxy.mjs"],
    ["serve", "../src/serve.mjs"],
    ["verify", "../src/verify.mjs"],
  ]);

  if (internal.has(command)) {
    process.argv.splice(2, 1);
    await import(internal.get(command));
  } else {
    const { main } = await import("../src/bimo.mjs");
    main().catch(error => {
      process.stderr.write(`bimo: ${error.message}\n`);
      process.exitCode = 1;
    });
  }
}
